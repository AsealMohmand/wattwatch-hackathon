# Code only: build plans and the slide deck stay local
/docs/
/presentation/

# Secrets and local settings
.env
.env.*
*.local
config.h
secrets.h

# Python (hub)
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Hub runtime data: the live database and anything trained from it.
