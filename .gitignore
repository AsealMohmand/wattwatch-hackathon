*.db
*.db-wal
*.db-shm
*.db-journal
/hub/model.joblib
/hub/model_report.json
*.tmp

# Web dependencies and build output (`npm install && npm run build` recreates them)
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
.vite/

# Playwright output (regenerated by `npm run e2e`)
/web/test-results/
/web/playwright-report/
/web/blob-report/
/web/e2e/screenshots/

# Firmware build output
/firmware/build/
*.bin
*.elf
*.hex
*.map

# Logs, lock files, OS/editor noise
*.log
npm-debug.log*
~$*
